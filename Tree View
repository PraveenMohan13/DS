static void Top_view(node root,int lev,int c_lev)
    {
        Queue<pair> q=new LinkedList<>();
        TreeMap<Integer,Integer> tm=new TreeMap<>();
        q.add(new pair(0,root));
        while(!q.isEmpty())
        {
            pair t=q.poll();
            if(!tm.containsKey(t.h_lev))    //if store last h_level it's bottom view so if simply remove if condition
            {
                tm.put(t.h_lev,t.nd.data);
            }
            if(t.nd.left!=null)
                q.add(new pair(t.h_lev-1,t.nd.left));
            if(t.nd.right!=null)
                q.add(new pair(t.h_lev+1,t.nd.right));
        }
        for(int a:tm.values())
        {
            System.out.print(a+ " ");
        }
        
    }
