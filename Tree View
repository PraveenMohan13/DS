======================================================LEFT VIEW - BFS(Level order - Queue)==========================================================
static void LeftView(node root)
    {
        Queue<node> q=new LinkedList<>();
        q.add(root);
        while(!q.isEmpty())
        {
            int n=q.size();
            System.out.print(q.peek().data+" ");
            for(int i=0;i<n;i++)
            {
                node t=q.poll();
                if(t.left!=null)
                    q.add(t.left);
                if(t.right!=null)
                    q.add(t.right);
            }   
        }
    }
==========================================LEFT VIEW - BFS(Level order - Queue)========Easy===========================================================
static void LeftView(node root)
    {
        Queue<node> q=new LinkedList<>();
        q.add(root);
        while(!q.isEmpty())
        {
            int n=q.size();
           
            for(int i=0;i<n;i++)
            {
                node t=q.poll();
                if(i==0)                                         //   if(i==n-1) right view
                     System.out.print(t.data+" ");
                
                if(t.left!=null)
                    q.add(t.left);
                if(t.right!=null)
                    q.add(t.right);
            }   
        }
    }
===============================================Right VIEW - BFS(Level order - Queue)========Easy==================================================================================================================
static void RightView(node root)
    {
        Queue<node> q=new LinkedList<>();
        if(root==null)
          return;
        q.add(root);
        while(!q.isEmpty())
        {
            int n=q.size();
           
            for(int i=0;i<n;i++)
            {
                node t=q.poll();
                if(i==n-1)                                       
                     System.out.print(t.data+" ");
                
                if(t.left!=null)
                    q.add(t.left);
                if(t.right!=null)
                    q.add(t.right);
            }   
        }
    }
