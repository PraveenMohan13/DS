======================================================LEFT VIEW - BFS(Level order - Queue)==========================================================
static void LeftView(node root)
    {
        Queue<node> q=new LinkedList<>();
        q.add(root);
        while(!q.isEmpty())
        {
            int n=q.size();
            System.out.print(q.peek().data+" ");
            for(int i=0;i<n;i++)
            {
                node t=q.poll();
                if(t.left!=null)
                    q.add(t.left);
                if(t.right!=null)
                    q.add(t.right);
            }   
        }
    }
